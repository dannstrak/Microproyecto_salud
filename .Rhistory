# Fase 1. Preparación
set.seed(123)
# Fase 2. Importar e inspeccionar
base <- read.csv2("data/raw/atenciones_raw.csv",
na.strings = c("NA", "N/A", "-", ""),
stringsAsFactors = FALSE)
str(base)
summary(base)
colSums(is.na(base))
head(base)
# Fase 3. Limpiar
base_original <- base
n_inicial <- nrow(base)
n_duplicados <- sum(duplicated(base))
base <- base[!duplicated(base), ]
n_id_repetidos <- sum(duplicated(base$id_atencion))
base$especialidad <- tolower(trimws(base$especialidad))
base$turno <- tolower(trimws(base$turno))
base$tipo_paciente <- tolower(trimws(base$tipo_paciente))
base$respondio_encuesta <- tolower(trimws(base$respondio_encuesta))
base$respondio_encuesta[base$respondio_encuesta %in% c("sí", "s", "yes")] <- "si"
base$respondio_encuesta[base$respondio_encuesta %in% c("no", "n")] <- "no"
# Convertir todos los tiempos a minutos
txt <- tolower(trimws(gsub(",", ".", base$tiempo_espera, fixed = TRUE)))
valor <- suppressWarnings(as.numeric(gsub("[^0-9.-]", "", txt)))
es_horas <- grepl("hora|h", txt)
base$espera_min <- ifelse(es_horas, valor * 60, valor)
n_negativos <- sum(base$espera_min < 0, na.rm = TRUE)
n_faltantes <- sum(is.na(base$espera_min))
summary(base$espera_min)
base$satisfaccion <- factor(base$satisfaccion,
levels = 1:5, ordered = TRUE)
f1 <- as.Date(base$fecha, format = "%d/%m/%Y")
f2 <- as.Date(base$fecha, format = "%Y-%m-%d")
base$fecha_limpia <- as.Date(ifelse(is.na(f1), f2, f1),
origin = "1970-01-01")
dir.create("data/processed", recursive = TRUE, showWarnings = FALSE)
write.csv2(base, "data/processed/atenciones.csv", row.names = FALSE, na = "NA")
# Fase 4. Describir la variable principal
base_analisis <- subset(base, !is.na(base$especialidad) &
!is.na(base$espera_min) & base$espera_min >= 0)
x <- base_analisis$espera_min
medidas <- c(media = mean(x), mediana = median(x), sd = sd(x),
IQR = IQR(x), minimo = min(x), maximo = max(x))
medidas
limite <- quantile(x, 0.75) + 1.5 * IQR(x)
sum(x > limite)
# El histograma y el diagrama de caja se dibujan en informe.qmd.
